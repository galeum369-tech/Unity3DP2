.button {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-left-color: rgb(236, 206, 206);
    border-right-color: rgb(236, 206, 206);
    border-top-color: rgb(236, 206, 206);
    border-bottom-color: rgb(236, 206, 206);
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    background-color: rgb(233, 98, 98);
}

.button:hover {
    background-color: rgb(207, 52, 52);
    transition-duration: 0.3s;
    scale: 1.1 1.1;
}

.button:active {
    background-color: rgb(253, 0, 0);
}

.label-title {
    background-color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-text-align: upper-center;
    -unity-font-style: bold;
    transition-duration: 0s;
    scale: 1 1;
}

.label-title:hover {
    transition-duration: 0.2s;
    scale: 1.5 1;
}
